.book-info{flex:1;min-width:0}
.book-title{font-size:14px;font-weight:500;color:var(--text1);margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.book-author{font-size:12px;color:var(--text3)}
.book-count{font-size:12px;color:var(--text3)}
.book-notes-preview{border-top:1px solid var(--border);padding:8px 16px;background:rgba(118,118,128,.03)}
.book-note-preview-item{font-size:12px;color:var(--text2);line-height:1.5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding:1px 0}
.book-note-preview-item::before{content:'❝ ';color:var(--text4);font-size:10px}

/* ── REVIEW ── */
/* ── REVIEW PAGE ── */
.review-week-nav{display:flex;align-items:center;gap:8px;margin-bottom:16px;background:rgba(255,255,255,.72);backdrop-filter:blur(20px) saturate(160%);-webkit-backdrop-filter:blur(20px) saturate(160%);border-radius:var(--r);padding:12px 16px;border:0.5px solid rgba(255,255,255,.9);box-shadow:var(--shadow-card)}
.review-week-arrow{background:none;border:none;cursor:pointer;color:var(--text3);font-size:18px;padding:2px 6px;border-radius:var(--rxs);transition:color .12s,background .12s;line-height:1;flex-shrink:0}
.review-week-arrow:hover{color:var(--text1);background:var(--surface3)}
.review-week-label{font-size:12px;color:var(--text3);font-weight:500;min-width:80px;text-align:center}
.review-week-days{display:flex;gap:6px;flex:1;justify-content:center}
.review-week-day{display:flex;flex-direction:column;align-items:center;gap:3px;padding:6px 10px;border-radius:var(--rxs);cursor:pointer;transition:background .15s;flex:1;max-width:52px}
