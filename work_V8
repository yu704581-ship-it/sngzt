/* ── CONTENTEDITABLE ENGINE ── */
var _ceSaveTimers={};
function ceHtmlToMd(el){
  function inline(node){
    if(node.nodeType===3)return node.textContent;
    var tag=(node.tagName||'').toLowerCase();
    var kids=Array.from(node.childNodes).map(inline).join('');
    if(tag==='br')return'\n';
    if(tag==='strong'||tag==='b')return'**'+kids+'**';
    if(tag==='em'||tag==='i')return'*'+kids+'*';
    if(tag==='mark')return'=='+kids+'==';
    if(tag==='code'&&(node.parentNode||{}).tagName!=='PRE')return'`'+kids+'`';
    if(tag==='a')return'['+kids+']('+(node.getAttribute('href')||'')+')';
    return kids;
  }
  function block(node){
    if(node.nodeType===3){var t=node.textContent;return t||null;}
    var tag=(node.tagName||'').toLowerCase();
    if(tag==='hr')return'---';
    var kids=Array.from(node.childNodes).map(inline).join('');
    if(tag==='h1')return'# '+kids.trim();
    if(tag==='h2')return'## '+kids.trim();
    if(tag==='h3')return'### '+kids.trim();
    if(tag==='blockquote')return'> '+kids.trim();
    if(tag==='pre'){var c=node.querySelector('code');return'```\n'+(c?c.textContent:node.textContent).trim()+'\n```';}
    if(tag==='ul'||tag==='ol'){
      return Array.from(node.children).map(function(li){
        return'- '+Array.from(li.childNodes).map(inline).join('').trim();
      }).join('\n');
    }
    return kids||null;
  }
  var lines=[];
  el.childNodes.forEach(function(node){var v=block(node);if(v!==null)lines.push(v);});
  return lines.join('\n').replace(/\n{3,}/g,'\n\n').trim();
}
function debounceCeSave(noteId){
  clearTimeout(_ceSaveTimers[noteId]);
  _ceSaveTimers[noteId]=setTimeout(function(){
    var ce=eid('nd-ce-'+noteId);if(!ce)return;
    updateNoteField(noteId,'body',ceHtmlToMd(ce));
  },600);
}
function ceWrapSel(tagName){
  var sel=window.getSelection();if(!sel.rangeCount||sel.isCollapsed)return;
  var range=sel.getRangeAt(0);
  // toggle: if entire selection is already inside the same tag, unwrap it
  var anc=range.commonAncestorContainer;
  var existing=(anc.nodeType===3?anc.parentNode:anc);
  if(existing&&existing.tagName&&existing.tagName.toLowerCase()===tagName.toLowerCase()){
    var parent=existing.parentNode;
    while(existing.firstChild)parent.insertBefore(existing.firstChild,existing);
    parent.removeChild(existing);
    return;
  }
  // also check if a single ancestor wraps the whole selection
  var wrapped=null;var node=anc.nodeType===3?anc.parentNode:anc;
  while(node&&node.contentEditable!=='true'){if(node.tagName&&node.tagName.toLowerCase()===tagName.toLowerCase()){wrapped=node;break;}node=node.parentNode;}
  if(wrapped){
    var p=wrapped.parentNode;
    while(wrapped.firstChild)p.insertBefore(wrapped.firstChild,wrapped);
