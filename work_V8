.status-opt.active-done{border-color:var(--s-done);background:rgba(52,199,89,.12);color:var(--s-done);font-weight:500}
.status-opt.active-cancel{border-color:var(--s-cancel);background:rgba(255,149,0,.12);color:var(--s-cancel);font-weight:500}
.pri-opt-row{display:flex;gap:6px}
.pri-opt{flex:1;height:32px;border-radius:var(--rxs);border:1.5px solid var(--border2);background:var(--surface2);cursor:pointer;font-size:12px;font-family:inherit;transition:all .14s;color:var(--text2)}
.pri-opt.active{border-color:var(--accent-border);background:var(--accent-light);color:var(--accent);font-weight:500}
.edit-link-row{display:flex;gap:6px;align-items:center;margin-bottom:6px}

/* ── SEARCH ── */
.search-overlay{position:fixed;inset:0;z-index:300;background:rgba(0,0,0,.5);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);animation:fadeIn .15s ease;display:flex;flex-direction:column}
.search-box{background:rgba(242,242,247,.96);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-bottom:1px solid var(--border);padding:12px 20px;display:flex;align-items:center;gap:10px}
.search-main-input{flex:1;height:38px;border:1px solid var(--border2);border-radius:var(--rs);background:var(--surface);padding:0 14px;font-family:inherit;font-size:15px;color:var(--text1);outline:none}
.search-cancel-btn{background:none;border:none;font-size:14px;color:var(--accent);cursor:pointer;font-family:inherit;padding:4px 2px}
.search-results{flex:1;overflow-y:auto;background:var(--bg);padding:14px 20px 40px}
.search-section-label{font-size:11px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--text3);margin:14px 0 7px}
.search-section-label:first-child{margin-top:0}
.search-result-item{background:var(--surface);border:1px solid var(--border);border-radius:var(--rs);padding:10px 14px;margin-bottom:5px;cursor:pointer;animation:fadeUp .14s var(--ease) both}
.search-result-item:hover{opacity:.82}
.search-result-title{font-size:13.5px;color:var(--text1);margin-bottom:3px}
.search-result-title mark{background:rgba(0,122,255,.14);color:var(--accent);border-radius:2px;padding:0 2px;font-style:normal}
.search-result-meta{font-size:11px;color:var(--text3);display:flex;gap:7px}
.search-empty{text-align:center;padding:48px 20px;color:var(--text3);font-size:13px}

/* ── TOAST ── */
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(10px);background:rgba(44,44,46,.92);backdrop-filter:blur(16px);color:#fff;padding:9px 18px;border-radius:20px;font-size:13px;z-index:500;opacity:0;pointer-events:none;transition:opacity .18s,transform .18s var(--spring);white-space:nowrap;box-shadow:var(--shadow-lg)}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* ── SETTINGS ── */
.settings-wrap{max-width:600px;margin:0 auto}
.settings-section{background:var(--surface);border-radius:var(--r);overflow:hidden;margin-bottom:12px;border:1px solid var(--border)}
.settings-section-head{padding:12px 16px 10px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:8px}
.settings-section-icon{font-size:14px}
.settings-section-title{font-size:13.5px;font-weight:600;color:var(--text1)}
.settings-section-desc{font-size:11px;color:var(--text3);margin-left:auto}
.settings-field{padding:10px 16px;border-bottom:1px solid var(--border)}
.settings-label{font-size:12px;font-weight:500;color:var(--text2);margin-bottom:5px;display:flex;align-items:center;gap:5px}
.settings-label-hint{font-size:11px;color:var(--text4)}
.settings-input{width:100%;height:38px;padding:0 12px;border:1px solid var(--border2);border-radius:var(--rs);background:var(--surface);font-family:inherit;font-size:13.5px;color:var(--text1);outline:none}
.settings-input:focus{border-color:var(--accent-border);box-shadow:0 0 0 3px var(--accent-light)}
.settings-input::placeholder{color:var(--text4)}
.settings-btn-row{display:flex;gap:7px;flex-wrap:wrap;padding:10px 16px}
.settings-btn{height:34px;padding:0 16px;border-radius:17px;border:none;font-family:inherit;font-size:12.5px;font-weight:500;cursor:pointer}
.settings-btn.primary{background:var(--accent);color:#fff}
.settings-btn.ghost{background:rgba(118,118,128,.1);color:var(--text2);border:1px solid var(--border2)}
.settings-btn.danger{background:rgba(255,59,48,.08);color:var(--del);border:1px solid rgba(255,59,48,.2)}
.settings-btn:hover{opacity:.82}
.sync-status-row{display:flex;align-items:center;gap:8px;padding:9px 16px;font-size:12px;color:var(--text2);border-top:1px solid var(--border)}
.sync-dot{width:7px;height:7px;border-radius:50%;background:var(--surface4);flex-shrink:0}
.sync-dot.ok{background:var(--done)}.sync-dot.err{background:var(--del)}.sync-dot.syncing{background:var(--accent);animation:pulse 1s ease infinite}
.settings-info{font-size:12px;color:var(--text3);line-height:1.65;padding:9px 16px;background:rgba(118,118,128,.04);border-top:1px solid var(--border)}
.settings-info a{color:var(--accent);text-decoration:none}
.inbox-overlay-bg{position:fixed;inset:0;z-index:199;background:rgba(0,0,0,.15)}

/* ── NEXTSTEP TOAST ── */
.nextstep-toast{position:fixed;right:22px;bottom:22px;z-index:600;display:none;align-items:center;gap:11px;background:var(--surface);border:1px solid var(--border2);border-radius:14px;padding:12px 14px;box-shadow:var(--shadow-lg);max-width:320px;transform:translateY(16px);opacity:0;transition:transform .2s ease,opacity .2s ease;}
.nextstep-toast.show{display:flex;transform:translateY(0);opacity:1;}
.nst-icon{width:26px;height:26px;border-radius:50%;background:var(--done);color:#fff;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;}
.nst-body{flex:1;min-width:0;}
.nst-title{font-size:12.5px;font-weight:600;color:var(--text1);}
.nst-sub{font-size:11px;color:var(--text3);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:160px;}
.nst-action{flex-shrink:0;background:var(--accent);color:#fff;border:none;border-radius:9px;padding:7px 12px;font-size:11.5px;font-weight:500;cursor:pointer;font-family:inherit;transition:opacity .12s;}
.nst-action:hover{opacity:.88;}
.nst-close{flex-shrink:0;background:none;border:none;color:var(--text4);font-size:16px;cursor:pointer;padding:0 2px;line-height:1;}
.nst-close:hover{color:var(--text2);}
.sb-btn.drag-over{background:rgba(0,122,255,.12);border:1px dashed var(--accent-border);}
.sb-btn[draggable]{cursor:grab;}
/* ── DUAL DAY VIEW ── */
.dual-day-wrap{display:flex;gap:12px;padding:14px 16px 16px;height:100%;box-sizing:border-box;overflow:hidden;}
.day-col{flex:1;display:flex;flex-direction:column;min-height:0;background:rgba(255,255,255,.52);backdrop-filter:blur(16px) saturate(150%);-webkit-backdrop-filter:blur(16px) saturate(150%);border:0.5px solid rgba(255,255,255,.8);border-radius:var(--r);overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,.08),inset 0 1px 0 rgba(255,255,255,.9);transition:border-color .15s,background .15s;}
.day-col.drag-target{border-color:var(--accent-border);background:rgba(0,122,255,.03);}
.day-col-hd{padding:11px 14px 9px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:7px;flex-shrink:0;}
.day-col-title{font-size:13.5px;font-weight:600;color:var(--text1);}
.day-col-count{font-size:10.5px;background:var(--surface3);color:var(--text3);border-radius:9px;padding:1px 7px;font-weight:500;}
.day-col-date{font-size:11px;color:var(--text3);margin-left:auto;}
.day-quick-row{display:flex;gap:5px;padding:7px 8px;border-bottom:1px solid var(--border);flex-shrink:0;}
.day-quick-inp{flex:1;border:none;background:var(--surface2);border-radius:var(--rxs);padding:5px 10px;font-size:13px;font-family:inherit;color:var(--text1);outline:none;transition:background .12s,box-shadow .12s;}
.day-quick-inp::placeholder{color:var(--text4);}
.day-quick-inp:focus{background:var(--accent-light);box-shadow:0 0 0 2px var(--accent-border);}
.day-add-btn{width:26px;height:26px;border-radius:var(--rxs);border:none;background:var(--accent);color:#fff;font-size:17px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:opacity .12s;}
.day-add-btn:hover{opacity:.85;}
.day-task-list{flex:1;overflow-y:auto;padding:4px 6px 10px;}
.day-task-list .task-item{margin-bottom:4px;transition:opacity .15s,border .12s;}
.day-task-list .task-item[draggable=true]{cursor:grab;}
.day-task-list .task-item[draggable=true]:active{cursor:grabbing;}
.day-task-list .task-item.dragging{opacity:.35;}
.day-task-list .task-item.drop-above{border-top:2px solid var(--accent);}
.day-task-list .task-item.drop-below{border-bottom:2px solid var(--accent);}
.day-empty{padding:40px 16px;text-align:center;color:var(--text4);}
.day-empty-icon{font-size:26px;margin-bottom:8px;}
.day-empty p{font-size:12.5px;line-height:1.6;}
/* ── INLINE NEXT STEP ── */
@keyframes inxtIn{from{opacity:0;transform:translateY(-5px);}to{opacity:1;transform:translateY(0);}}
.inline-nxt{display:flex;align-items:center;gap:8px;padding:4px 10px 8px 36px;animation:inxtIn .2s ease;}
.inline-nxt span{font-size:11.5px;color:var(--text3);}
.inline-nxt-btn{padding:2px 11px;border-radius:9px;border:1px solid rgba(88,86,214,.3);background:rgba(88,86,214,.08);color:#5856d6;font-size:11.5px;cursor:pointer;font-family:inherit;transition:background .12s;}
.inline-nxt-btn:hover{background:rgba(88,86,214,.18);}
/* ── TASK MODAL COMPACT ── */
.task-title-big{width:100%;border:none;border-bottom:2px solid var(--accent);outline:none;font-size:17px;font-weight:600;color:var(--text1);font-family:inherit;padding:4px 0 9px;background:transparent;}
.task-meta-pills{display:flex;gap:5px;flex-wrap:wrap;margin:10px 0 12px;}
.tpill{display:inline-flex;align-items:center;gap:3px;font-size:12px;padding:5px 11px;border-radius:20px;border:1px solid var(--border2);background:var(--surface2);color:var(--text2);cursor:pointer;user-select:none;transition:all .12s;}
.tpill:hover{border-color:var(--accent-border);background:var(--accent-light);}
.tpill.st-done{background:rgba(52,199,89,.1);color:#1a7f37;border-color:rgba(52,199,89,.3);}
.tpill.st-doing{background:var(--accent-light);color:var(--accent);border-color:var(--accent-border);}
.tpill.st-cancel{background:rgba(255,149,0,.08);color:#b85c00;border-color:rgba(255,149,0,.3);}
.tpill.pri-important{background:rgba(255,204,0,.1);color:#8a6000;border-color:rgba(255,204,0,.4);}
.tpill.pri-urgent{background:rgba(255,59,48,.08);color:var(--del);border-color:rgba(255,59,48,.2);}
.tpill-picker{position:fixed;background:var(--surface);border:1px solid var(--border2);border-radius:var(--rs);box-shadow:var(--shadow-lg);z-index:700;padding:4px;display:flex;flex-direction:column;gap:1px;min-width:110px;}
.tpick-opt{padding:7px 12px;border-radius:var(--rxs);border:none;background:transparent;font-size:13px;font-family:inherit;cursor:pointer;text-align:left;color:var(--text1);transition:background .1s;}
.tpick-opt:hover{background:var(--surface2);}
.tpick-opt.cur{background:var(--accent-light);color:var(--accent);}
.task-note-bare{width:100%;border:none;outline:none;resize:none;font-size:13.5px;font-family:inherit;color:var(--text1);line-height:1.7;background:transparent;min-height:72px;}
.modal-rule{height:1px;background:var(--border);margin:2px 0 10px;}
.task-extra-tog{font-size:12px;color:var(--accent);cursor:pointer;padding:2px 0;background:none;border:none;font-family:inherit;}
/* ── NOTES LIST VIEW ── */
.notes-list{display:flex;flex-direction:column;}
.note-row{display:flex;align-items:center;gap:12px;padding:12px 16px 12px 14px;cursor:pointer;transition:background .12s;border-bottom:1px solid var(--border);position:relative;}
.note-row::before{content:'';position:absolute;left:0;top:8px;bottom:8px;width:3px;border-radius:2px;background:var(--note-accent,var(--border2));transition:background .12s;}
.note-row:hover{background:var(--surface2);}
.note-row:hover::before{background:var(--accent);}
.note-row:last-child{border-bottom:none;}
.note-row-ico{font-size:15px;flex-shrink:0;width:20px;text-align:center;opacity:.7;}
.note-row-body{flex:1;min-width:0;}
.note-row-title{font-size:14px;color:var(--text1);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;letter-spacing:-.01em;}
.note-row-preview{font-size:12px;color:var(--text3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:3px;line-height:1.4;}
.note-row-meta{display:flex;flex-direction:column;align-items:flex-end;gap:4px;flex-shrink:0;min-width:52px;}
.note-row-cat{font-size:10px;padding:2px 8px;border-radius:5px;background:var(--surface3);color:var(--text2);font-weight:500;}
.note-row-date{font-size:10.5px;color:var(--text4);}
.note-row-del{opacity:0;border:none;background:transparent;color:var(--del);cursor:pointer;font-size:16px;padding:0 4px;line-height:1;transition:opacity .12s;flex-shrink:0;}
.note-row:hover .note-row-del{opacity:1;}
.note-row.cat-experience::before{background:#007aff44;}.note-row.cat-experience:hover::before{background:#007aff;}
.note-row.cat-method::before{background:#34c75944;}.note-row.cat-method:hover::before{background:#34c759;}
.note-row.cat-idea::before{background:#ff950044;}.note-row.cat-idea:hover::before{background:#ff9500;}
.note-row.cat-followup::before{background:#af52de44;}.note-row.cat-followup:hover::before{background:#af52de;}
.note-row.cat-other::before{background:#8e8e9344;}.note-row.cat-other:hover::before{background:#8e8e93;}
.cat-add-row{display:flex;gap:6px;padding:10px 0 2px;}
.cat-add-inp{flex:1;border:1px solid var(--border2);border-radius:var(--rxs);padding:5px 10px;font-size:13px;font-family:inherit;outline:none;}
.cat-add-inp:focus{border-color:var(--accent-border);}
.note-search-inp{flex:1;border:1px solid var(--border2);border-radius:20px;padding:7px 16px;font-size:13px;font-family:inherit;outline:none;background:var(--surface2);color:var(--text1);transition:border .12s;}
.note-search-inp:focus{border-color:var(--accent-border);background:var(--surface);}
/* ── MARKDOWN EDITOR ── */
.md-toolbar{display:flex;gap:1px;padding:4px 8px;border-bottom:1px solid var(--border);flex-wrap:wrap;align-items:center;flex-shrink:0;}
.md-tb-btn{width:28px;height:26px;display:flex;align-items:center;justify-content:center;border:none;background:transparent;border-radius:var(--rxs);cursor:pointer;font-size:12px;color:var(--text2);font-family:inherit;font-weight:600;transition:background .1s;}
.md-tb-btn:hover{background:var(--surface2);color:var(--text1);}
.md-tb-sep{width:1px;height:16px;background:var(--border);margin:0 3px;flex-shrink:0;}
.md-tb-toggle{margin-left:auto;font-size:11px;padding:3px 10px;border-radius:9px;border:1px solid var(--border2);background:transparent;color:var(--text2);cursor:pointer;font-family:inherit;transition:all .12s;}
.md-tb-toggle.on{background:var(--accent-light);color:var(--accent);border-color:var(--accent-border);}
.md-preview{flex:1;overflow-y:auto;padding:14px 20px;line-height:1.75;font-size:14px;color:var(--text1);}
.md-preview h1{font-size:22px;font-weight:700;margin:14px 0 7px;}
.md-preview h2{font-size:18px;font-weight:600;margin:12px 0 6px;}
.md-preview h3{font-size:15px;font-weight:600;margin:10px 0 5px;}
.md-preview p{margin:0 0 8px;}
.md-preview strong{font-weight:600;}
.md-preview em{font-style:italic;}
.md-preview mark{background:#fef9c3;border-radius:2px;padding:0 2px;}
.md-preview code{background:var(--surface3);padding:1px 5px;border-radius:4px;font-family:monospace;font-size:12.5px;}
.md-preview pre{background:var(--surface3);border-radius:var(--rs);padding:12px 14px;overflow-x:auto;margin:8px 0;}
.md-preview pre code{background:none;padding:0;font-size:13px;}
.md-preview blockquote{border-left:3px solid var(--accent-border);padding:3px 12px;margin:8px 0;color:var(--text2);}
.md-preview ul{padding-left:20px;margin:6px 0;list-style:disc;}
.md-preview ol{padding-left:20px;margin:6px 0;}
.md-preview li{margin:2px 0;}
.md-preview hr{border:none;border-top:1px solid var(--border);margin:12px 0;}
.md-preview a{color:var(--accent);text-decoration:underline;text-underline-offset:2px;}
.md-paste-prompt{display:flex;align-items:center;gap:7px;padding:7px 12px;background:var(--surface);border:1px solid var(--accent-border);border-radius:var(--rs);margin-bottom:8px;animation:inxtIn .2s ease;}
.md-pp-txt{font-size:12px;color:var(--text2);flex:1;}
.md-pp-btn{padding:3px 10px;border-radius:9px;border:1px solid var(--border2);background:var(--surface2);font-size:11.5px;cursor:pointer;font-family:inherit;color:var(--text2);}
.md-pp-btn.ok{background:var(--accent);color:#fff;border-color:var(--accent);}
.md-pp-x{border:none;background:none;cursor:pointer;color:var(--text3);font-size:15px;line-height:1;padding:0;}
/* ── CONTENTEDITABLE NOTE EDITOR ── */
.note-ce-editor{flex:1;overflow-y:auto;padding:14px 20px;line-height:1.8;font-size:14px;color:var(--text1);outline:none;min-height:120px;}
.note-ce-editor:empty::before{content:attr(data-placeholder);color:var(--text4);pointer-events:none;}
.note-ce-editor h1{font-size:22px;font-weight:700;margin:10px 0 6px;letter-spacing:-.03em;}
.note-ce-editor h2{font-size:18px;font-weight:600;margin:8px 0 5px;}
.note-ce-editor h3{font-size:15px;font-weight:600;margin:6px 0 4px;}
.note-ce-editor p,.note-ce-editor div{margin:0 0 2px;min-height:1.5em;}
.note-ce-editor strong{font-weight:600;}
.note-ce-editor em{font-style:italic;}
.note-ce-editor mark{background:#fef9c3;border-radius:2px;padding:0 2px;}
.note-ce-editor code{background:var(--surface3);padding:1px 5px;border-radius:4px;font-family:monospace;font-size:12.5px;}
.note-ce-editor pre{background:var(--surface3);border-radius:var(--rs);padding:12px 14px;overflow-x:auto;margin:8px 0;font-family:monospace;font-size:13px;}
.note-ce-editor blockquote{border-left:3px solid var(--accent-border);padding:3px 12px;margin:6px 0;color:var(--text2);}
.note-ce-editor ul,.note-ce-editor ol{padding-left:20px;margin:4px 0;}
.note-ce-editor li{margin:2px 0;}
.note-ce-editor hr{border:none;border-top:1px solid var(--border);margin:12px 0;}
.note-ce-editor a{color:var(--accent);text-decoration:underline;text-underline-offset:2px;}
/* ── REVIEW ── */
.review-q-label-row{display:flex;align-items:center;gap:6px;margin-bottom:6px;}
.review-q-edit-inp{flex:1;border:none;border-bottom:1.5px solid var(--accent-border);outline:none;font-size:11.5px;font-weight:600;color:var(--text2);background:transparent;font-family:inherit;padding:1px 0;letter-spacing:.01em;}
.review-q-edit-inp:focus{border-bottom-color:var(--accent);}
.review-q-edit-btn{border:none;background:none;cursor:pointer;font-size:10px;color:var(--text4);padding:2px 4px;border-radius:4px;font-family:inherit;}
.review-q-edit-btn:hover{color:var(--accent);background:var(--accent-light);}
.review-export-btn{display:flex;align-items:center;gap:5px;padding:5px 14px;border-radius:var(--rxs);border:1px solid var(--border2);background:var(--surface2);color:var(--text2);font-size:12px;cursor:pointer;font-family:inherit;}
.review-export-btn:hover{border-color:var(--accent-border);color:var(--accent);}
.export-modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.35);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);z-index:1000;display:flex;align-items:center;justify-content:center;animation:fadeIn .15s ease}
.export-modal{background:rgba(255,255,255,.95);backdrop-filter:blur(24px) saturate(160%);-webkit-backdrop-filter:blur(24px) saturate(160%);border-radius:var(--r);padding:24px;width:480px;max-width:90vw;max-height:80vh;display:flex;flex-direction:column;box-shadow:var(--shadow-lg);border:0.5px solid rgba(255,255,255,.9)}
.export-modal-title{font-size:16px;font-weight:600;color:var(--text1);margin-bottom:16px}
.export-modal-list{flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:6px;margin-bottom:16px;max-height:340px}
.export-modal-item{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:var(--rxs);border:1px solid var(--border);cursor:pointer;transition:background .12s;user-select:none}
.export-modal-item:hover{background:var(--surface3)}
.export-modal-item.selected{background:var(--accent-light);border-color:var(--accent-border)}
.export-modal-item input[type=checkbox]{accent-color:var(--accent);width:15px;height:15px;flex-shrink:0;pointer-events:none}
.export-modal-item-info{flex:1}
.export-modal-item-title{font-size:13px;font-weight:500;color:var(--text1)}
.export-modal-item-meta{font-size:11px;color:var(--text3);margin-top:2px}
.export-modal-actions{display:flex;gap:8px;justify-content:flex-end}
.export-modal-sel-all{font-size:12px;color:var(--accent);cursor:pointer;background:none;border:none;padding:0;font-family:inherit;margin-right:auto;align-self:center}
/* ── PROJECT LOG ── */
.tl-wrap{padding:16px 24px 60px;max-width:860px;margin:0 auto}
.tl-year-sep{font-size:10px;color:var(--text3);letter-spacing:.06em;text-transform:uppercase;margin:18px 0 10px;display:flex;align-items:center;gap:8px}
.tl-year-sep:first-child{margin-top:0}
.tl-year-sep::after{content:'';flex:1;height:1px;background:var(--border)}
.tl-entry{display:flex;gap:10px;margin-bottom:10px}
.tl-spine{display:flex;flex-direction:column;align-items:center;width:22px;flex-shrink:0}
.tl-dot{width:10px;height:10px;border-radius:50%;margin-top:5px;flex-shrink:0}
.tl-dot.feat{background:#007aff}.tl-dot.fix{background:var(--del)}.tl-dot.opt{background:var(--done)}.tl-dot.mix{background:var(--surface4)}
.tl-dot.thought-dot{background:#af52de}.tl-dot.thought-doing{background:var(--accent)}.tl-dot.thought-solved{background:var(--done)}
.tl-spine-line{width:1px;flex:1;background:var(--border);margin-top:3px}
.tl-card{flex:1;background:var(--surface);border:1px solid var(--border);border-radius:var(--rs);padding:10px 13px;box-shadow:var(--shadow-card);animation:cardIn .2s var(--spring) both}
.tl-card-head{display:flex;align-items:flex-start;margin-bottom:6px}
.tl-ver{font-size:13px;font-weight:500;color:var(--text1);flex:1}
.tl-time{font-size:11px;color:var(--text4);flex-shrink:0}
.tl-badges{display:flex;gap:3px;flex-wrap:wrap;margin-bottom:7px}
.tl-badge{font-size:10px;padding:1px 7px;border-radius:9px;border:1px solid}
.tl-badge.feat{background:rgba(0,122,255,.08);color:var(--accent);border-color:rgba(0,122,255,.2)}
.tl-badge.fix{background:rgba(255,59,48,.08);color:var(--del);border-color:rgba(255,59,48,.2)}
.tl-badge.opt{background:rgba(52,199,89,.08);color:#1a7f37;border-color:rgba(52,199,89,.2)}
.tl-badge.custom{background:rgba(118,118,128,.08);color:var(--text2);border-color:var(--border2)}
.tl-point-row{font-size:13px;color:var(--text1);display:flex;gap:6px;margin-bottom:2px;line-height:1.5}
.tl-bullet{color:var(--text4);flex-shrink:0}
.tl-card-actions{display:flex;gap:5px;margin-top:8px}
.tl-act-btn{height:22px;padding:0 10px;border-radius:11px;border:1px solid var(--border2);background:transparent;font-size:11.5px;cursor:pointer;font-family:inherit;color:var(--text2);transition:background .12s}
.tl-act-btn:hover{background:rgba(118,118,128,.1)}.tl-act-btn.del:hover{color:var(--del)}
.tl-card.is-thought{border-left:3px solid #af52de}
.tl-card.is-thought.st-solved{border-left-color:var(--done);background:rgba(52,199,89,.03)}
.tl-card.is-thought.st-doing{border-left-color:var(--accent)}
.th-type-badge{font-size:10px;font-weight:600;letter-spacing:.03em;color:var(--text3);margin-bottom:5px}
.tl-note-title{font-size:13px;font-weight:500;color:var(--text1);flex:1;line-height:1.4}
.tl-note-body{font-size:12.5px;color:var(--text2);line-height:1.6;margin-top:5px}
.st-row{display:flex;align-items:center;gap:5px;margin-top:8px;flex-wrap:wrap}
.st-lbl{font-size:10.5px;color:var(--text3);margin-right:2px}
.st-btn{font-size:10px;padding:2px 10px;border-radius:9px;border:1px solid var(--border2);background:var(--surface2);color:var(--text3);cursor:pointer;font-family:inherit;transition:all .1s}
.st-btn.active-pending{background:rgba(255,59,48,.08);color:var(--del);border-color:rgba(255,59,48,.2)}
.st-btn.active-doing{background:var(--accent-light);color:var(--accent);border-color:var(--accent-border)}
.st-btn.active-solved{background:rgba(52,199,89,.08);color:#1a7f37;border-color:rgba(52,199,89,.2)}
.solved-ts{font-size:10.5px;color:#1a7f37;margin-top:4px}
.proj-sb-section{padding:4px 8px}
.proj-sb-label{font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--text4);padding:4px 8px 5px}
.proj-item{display:flex;align-items:center;gap:7px;padding:6px 10px;border-radius:var(--rxs);font-size:12.5px;color:var(--text2);cursor:pointer;margin-bottom:1px;transition:background .1s;position:relative}
.proj-item:hover{background:rgba(0,122,255,.06)}
.proj-item.active{background:rgba(0,122,255,.1);color:var(--accent);font-weight:500}
.proj-dot-sm{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.proj-add-btn{display:flex;align-items:center;gap:5px;padding:5px 10px;border-radius:var(--rxs);font-size:11.5px;color:var(--text3);cursor:pointer;border:none;background:none;font-family:inherit;width:100%;transition:color .1s}
.proj-add-btn:hover{color:var(--accent);background:rgba(0,122,255,.06)}
.proj-del-btn{opacity:0;font-size:11px;color:var(--del);padding:0 2px;background:none;border:none;cursor:pointer;transition:opacity .1s}
.proj-item:hover .proj-del-btn{opacity:1}
.pl-field{margin-bottom:14px}
.pl-label{font-size:11px;color:var(--text3);margin-bottom:5px}
.pl-inp{width:100%;border:none;border-bottom:1.5px solid var(--accent);outline:none;font-size:14px;font-weight:500;color:var(--text1);background:transparent;font-family:inherit;padding:4px 0 6px}
.pl-textarea{width:100%;border:1px solid var(--border2);border-radius:var(--rs);padding:9px 11px;font-size:13px;color:var(--text1);background:var(--surface);font-family:inherit;outline:none;resize:vertical;min-height:80px;line-height:1.65}
.pl-textarea:focus{border-color:var(--accent-border);box-shadow:0 0 0 3px var(--accent-light)}
.pl-tag-row{display:flex;gap:5px;flex-wrap:wrap;align-items:center}
.pl-tag{font-size:10.5px;padding:3px 9px;border-radius:9px;border:1px solid var(--border2);background:var(--surface2);color:var(--text2);cursor:pointer;display:flex;align-items:center;gap:4px;user-select:none}
.pl-tag.selected.feat{background:rgba(0,122,255,.1);color:var(--accent);border-color:var(--accent-border)}
.pl-tag.selected.fix{background:rgba(255,59,48,.08);color:var(--del);border-color:rgba(255,59,48,.2)}
.pl-tag.selected.opt{background:rgba(52,199,89,.08);color:#1a7f37;border-color:rgba(52,199,89,.2)}
.pl-tag.selected.custom{background:rgba(118,118,128,.1);color:var(--text1);border-color:var(--border2)}
.pl-tag-add{font-size:10.5px;padding:3px 9px;border-radius:9px;border:1px dashed var(--border2);background:none;color:var(--text3);cursor:pointer;font-family:inherit}
/* ── CHAIN ── */
.chain-badge{display:inline-flex;align-items:center;gap:3px;font-size:10px;color:#5856d6;background:rgba(88,86,214,.1);border:1px solid rgba(88,86,214,.2);border-radius:5px;padding:1px 6px;cursor:pointer;font-weight:500;transition:background .12s;white-space:nowrap}
.chain-badge:hover{background:rgba(88,86,214,.18)}
.chain-view-wrap{padding:16px 20px 60px;max-width:860px;margin:0 auto}
.chain-group{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:12px 14px;margin-bottom:12px;box-shadow:var(--shadow-card);animation:cardIn .2s var(--spring)}
.chain-group-label{font-size:10.5px;font-weight:600;color:#5856d6;margin-bottom:8px;display:flex;align-items:center;gap:5px;letter-spacing:.02em}
.chain-task-row{display:flex;gap:10px;align-items:flex-start;padding:8px 0;cursor:pointer}
.chain-task-row:not(:last-child){border-bottom:1px dashed var(--border)}
.chain-step-col{display:flex;flex-direction:column;align-items:center;width:20px;flex-shrink:0;padding-top:1px}
.chain-step-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0}
.chain-step-dot.s-todo{background:var(--surface3);border:1.5px solid var(--surface4)}
.chain-step-dot.s-doing{background:var(--accent)}
.chain-step-dot.s-done{background:var(--done)}
.chain-step-dot.s-cancel{background:var(--warn)}
.chain-step-line{width:1px;flex:1;background:var(--border);margin-top:3px}
.chain-task-body{flex:1;min-width:0}
.chain-task-title{font-size:13px;color:var(--text1);line-height:1.4}
.chain-task-title.done{text-decoration:line-through;color:var(--text4)}
.chain-task-meta{font-size:11px;color:var(--text3);margin-top:2px;display:flex;gap:5px}
.chain-modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.4);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);z-index:410;display:none;align-items:center;justify-content:center;animation:fadeIn .16s ease}
.chain-modal-overlay.open{display:flex}
.chain-box{background:rgba(242,242,247,.98);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-radius:16px;width:min(460px,92vw);padding:22px;box-shadow:var(--shadow-lg)}
.chain-from{font-size:11px;color:var(--text3);margin-bottom:14px}
.chain-title-inp{width:100%;border:none;border-bottom:1.5px solid #5856d6;outline:none;font-size:14px;font-weight:500;color:var(--text1);background:transparent;font-family:inherit;padding:3px 0 7px;margin-bottom:12px}
.chain-remark{width:100%;border:1px solid var(--border2);border-radius:var(--rs);padding:9px 11px;font-size:13px;color:var(--text1);background:var(--surface);font-family:inherit;resize:none;min-height:56px;line-height:1.65;outline:none}
.chain-remark:focus{border-color:rgba(88,86,214,.4);box-shadow:0 0 0 3px rgba(88,86,214,.1)}
.chain-btns{display:flex;gap:8px;margin-top:14px}
.chain-skip{flex:1;padding:9px;border-radius:var(--rs);border:1px solid var(--border2);background:none;font-size:13px;color:var(--text2);cursor:pointer;font-family:inherit}
.chain-confirm{flex:2;padding:9px;border-radius:var(--rs);border:none;background:#5856d6;color:#fff;font-size:13px;font-weight:500;cursor:pointer;font-family:inherit;transition:opacity .12s}
.chain-confirm:hover{opacity:.88}
.chain-detail-overlay{position:fixed;inset:0;background:rgba(0,0,0,.4);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);z-index:420;display:none;align-items:center;justify-content:center}
.chain-detail-overlay.open{display:flex}
.chain-detail-box{background:rgba(242,242,247,.98);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-radius:16px;width:min(400px,92vw);max-height:80dvh;overflow-y:auto;padding:20px;box-shadow:var(--shadow-lg);animation:slideUp .2s var(--spring)}
.chain-detail-hd{font-size:15px;font-weight:600;color:var(--text1);margin-bottom:16px;display:flex;align-items:center;justify-content:space-between}
.chain-detail-item{display:flex;gap:10px;align-items:flex-start}
.chain-detail-dot{width:22px;height:22px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:11px;margin-top:1px}
.chain-detail-dot.done{background:var(--done);color:#fff}
.chain-detail-dot.doing{background:var(--accent);color:#fff}
.chain-detail-dot.todo{background:var(--surface2);border:1.5px solid var(--surface4)}
.chain-detail-dot.cancel{background:rgba(255,149,0,.15)}
.chain-detail-body{flex:1;padding-bottom:12px;cursor:pointer}
.chain-detail-body:hover .chain-detail-ttl{color:var(--accent)}
.chain-detail-ttl{font-size:13px;color:var(--text1);line-height:1.4;font-weight:500}
.chain-detail-ttl.done{text-decoration:line-through;color:var(--text4)}
.chain-detail-sub{font-size:11px;color:var(--text3);margin-top:2px}
.chain-detail-line{width:1px;height:12px;background:var(--border);margin-left:10px}
</style>
</head>
<body>

<!-- SIDEBAR -->
<div class="sidebar" id="sidebar">
  <div class="sb-header">
    <div class="sb-logo">工作台 <span class="sb-logo-ver">v2.8</span></div>
    <div class="sb-date" id="sb-date"></div>
  </div>
  <div class="sb-nav">
    <div class="sb-section">主要</div>
    <button class="sb-btn active" id="sb-today" onclick="switchTab('today')">
      <i class="ti ti-sun sb-icon" aria-hidden="true"></i>
      <span class="sb-label">今日</span>
      <span class="sb-count" id="sb-today-count" style="display:none"></span>
    </button>
    <button class="sb-btn" id="sb-tasks" onclick="switchTab('tasks')">
      <i class="ti ti-checkbox sb-icon" aria-hidden="true"></i>
      <span class="sb-label">任务</span>
      <span class="sb-count" id="sb-tasks-count" style="display:none"></span>
    </button>
    <div class="sb-divider"></div>
    <div class="sb-section">内容</div>
    <!-- draggable content tabs, rendered by renderSbContentList() -->
    <div id="sb-content-list"></div>
    <!-- proj list, shown only on proj tab -->
    <div id="sb-proj-list" style="display:none"></div>
    <div class="sb-divider"></div>
    <div class="sb-section">分析</div>
    <button class="sb-btn" id="sb-analysis" onclick="switchTab('analysis')">
      <i class="ti ti-chart-bar sb-icon" aria-hidden="true"></i>
      <span class="sb-label">数据分析</span>
    </button>
  </div>
  <div class="sb-bottom">
    <button class="sb-btn" id="sb-settings" onclick="switchTab('settings')">
      <i class="ti ti-settings sb-icon" aria-hidden="true"></i>
      <span class="sb-label">设置</span>
    </button>
  </div>
</div>

<!-- APP BODY -->
<div class="app-body">

  <!-- TOPBAR -->
  <div class="topbar">
    <span class="topbar-title" id="topbar-title">今日</span>
    <div class="topbar-spacer"></div>
    <div class="search-trigger" onclick="openSearch()" title="搜索 (/)">
      <i class="ti ti-search" style="font-size:14px;color:var(--text3)" aria-hidden="true"></i>
      <span class="search-trigger-text">搜索任务、笔记、读书…</span>
      <span class="search-kbd">/</span>
    </div>
    <span class="topbar-date" id="topbar-date"></span>
  </div>

  <!-- TOOLBAR -->
  <div class="toolbar" id="toolbar">
    <button class="inbox-btn" onclick="openInbox()" id="toolbar-inbox-btn">
      <i class="ti ti-inbox" style="font-size:13px" aria-hidden="true"></i>
      收集箱
      <span class="inbox-badge" id="toolbar-inbox-badge" style="display:none">0</span>
    </button>
    <div style="width:1px;height:16px;background:var(--border2);margin:0 2px" id="toolbar-sep1"></div>
    <!-- list filters -->
    <div id="toolbar-filters" style="display:flex;gap:6px;align-items:center">
      <button class="filter-pill active" id="fp-all" onclick="setTaskFilter('all',this)">全部</button>
      <button class="filter-pill" id="fp-todo" onclick="setTaskFilter('todo',this)">待办</button>
      <button class="filter-pill" id="fp-done" onclick="setTaskFilter('done',this)">完成</button>
    </div>
    <div style="width:1px;height:16px;background:var(--border2);margin:0 2px" id="toolbar-sep2"></div>
    <button class="toolbar-btn" onclick="openBatchManage()"><i class="ti ti-list-check"></i>批量管理</button>
    <button class="toolbar-btn" onclick="openRecurringManager()"><i class="ti ti-repeat"></i>重复任务</button>
    <div class="toolbar-spacer" id="toolbar-spacer"></div>
    <!-- view seg (tasks only) -->
    <div class="view-seg" id="view-seg">
      <button class="view-seg-btn active" id="vb-list" onclick="setTaskView('list')"><i class="ti ti-list"></i>列表</button>
      <button class="view-seg-btn" id="vb-kanban" onclick="setTaskView('kanban')"><i class="ti ti-layout-columns"></i>看板</button>
      <button class="view-seg-btn" id="vb-matrix" onclick="setTaskView('matrix')"><i class="ti ti-layout-grid"></i>四象限</button>
      <button class="view-seg-btn" id="vb-chain" onclick="setTaskView('chain')"><i class="ti ti-link"></i>链路</button>
    </div>
    <div style="width:1px;height:16px;background:var(--border2);margin:0 2px" id="toolbar-sep3"></div>
    <button class="btn-add" id="toolbar-add-btn" onclick="openAddTask()"><i class="ti ti-plus" style="font-size:14px"></i>新建任务</button>
  </div>

  <!-- MAIN -->
  <div class="main">

    <!-- TODAY -->
    <div class="page active" id="page-today">
      <div class="dual-day-wrap">
        <!-- TODAY COLUMN -->
        <div class="day-col" id="day-col-today"
          ondragover="dayColDragOver(event,'today')"
          ondragleave="dayColDragLeave(event,'today')"
          ondrop="dayColDrop(event,'today')">
          <div class="day-col-hd">
            <span class="day-col-title">今天</span>
            <span class="day-col-count" id="today-col-count"></span>
            <span class="day-col-date" id="today-col-date"></span>
          </div>
          <div class="day-quick-row">
            <input class="day-quick-inp" id="today-quick-inp" placeholder="快速添加任务… Enter 提交"
              onkeydown="if(event.key==='Enter'){event.preventDefault();quickAddToDay('today-quick-inp','today');}" />
            <button class="day-add-btn" onclick="quickAddToDay('today-quick-inp','today')">+</button>
          </div>
          <div class="day-task-list" id="today-tasks"
            ondragover="event.preventDefault()"
            ondrop="dayListDrop(event,'today')"></div>
        </div>
        <!-- TOMORROW COLUMN -->
        <div class="day-col" id="day-col-tomorrow"
          ondragover="dayColDragOver(event,'tomorrow')"
          ondragleave="dayColDragLeave(event,'tomorrow')"
          ondrop="dayColDrop(event,'tomorrow')">
          <div class="day-col-hd">
            <span class="day-col-title">明天</span>
            <span class="day-col-count" id="tomorrow-col-count"></span>
            <span class="day-col-date" id="tomorrow-col-date"></span>
          </div>
          <div class="day-quick-row">
            <input class="day-quick-inp" id="tomorrow-quick-inp" placeholder="计划明天的任务… Enter 提交"
              onkeydown="if(event.key==='Enter'){event.preventDefault();quickAddToDay('tomorrow-quick-inp','tomorrow');}" />
            <button class="day-add-btn" onclick="quickAddToDay('tomorrow-quick-inp','tomorrow')">+</button>
          </div>
          <div class="day-task-list" id="tomorrow-tasks"
            ondragover="event.preventDefault()"
            ondrop="dayListDrop(event,'tomorrow')"></div>
        </div>
      </div>
    </div>

    <!-- TASKS -->
    <div class="page" id="page-tasks">
      <!-- list view -->
      <div id="task-list-view" class="wrap" style="padding-top:16px"></div>
      <!-- kanban view -->
      <div id="task-kanban-view" style="display:none;position:absolute;inset:0;overflow:hidden">
        <div class="kanban-wrap" id="kanban-columns"></div>
      </div>
      <!-- matrix view -->
      <div id="task-matrix-view" style="display:none;position:absolute;inset:0;overflow:hidden;display:flex;flex-direction:column">
        <div class="matrix-wrap">
          <div class="mx-axis-row">
            <span>↑ 重要</span>
            <span style="flex:1;text-align:center;font-size:11px;color:var(--text3)">← 不紧急 · · · · 紧急 →</span>
            <span>不重要 ↓</span>
          </div>
          <div class="mx-grid" id="matrix-grid"></div>
        </div>
      </div>
      <!-- chain view -->
      <div id="task-chain-view" style="display:none;position:absolute;inset:0;overflow-y:auto"></div>
    </div>

    <!-- NOTES -->
    <div class="page" id="page-notes">
      <div class="wrap">
        <div style="display:flex;gap:8px;align-items:center;margin-bottom:14px">
          <input class="note-search-inp" id="note-search-inp" placeholder="🔍 搜索标题、内容…" oninput="filterNoteSearch(this.value)" />
          <button class="btn-add" onclick="openNewNote('experience')"><i class="ti ti-plus" style="font-size:14px"></i>新建笔记</button>
        </div>
        <div class="notes-toolbar" id="notes-toolbar"></div>
        <div id="notes-list" style="display:flex;flex-direction:column;width:100%"></div>
      </div>
      <div id="note-detail-panel" style="display:none;position:absolute;inset:0"></div>
    </div>

    <!-- BOOKS -->
    <div class="page" id="page-books">
      <div class="wrap">
        <div style="display:flex;justify-content:flex-end;margin-bottom:16px">
          <button class="btn-add" onclick="openAddBook()"><i class="ti ti-plus" style="font-size:14px"></i>加书</button>
        </div>
        <div class="book-grid" id="book-list"></div>
      </div>
      <div id="book-detail-panel" style="display:none;position:absolute;inset:0"></div>
    </div>

    <!-- REVIEW -->
    <div class="page" id="page-review">
      <div class="wrap">
        <div id="review-week-nav-wrap"></div>
        <div id="review-list"></div>
      </div>
      <div id="review-detail-panel" style="display:none;position:absolute;inset:0"></div>
      <div id="review-export-modal-wrap"></div>
    </div>

    <!-- ANALYSIS -->
    <div class="page" id="page-analysis">
      <div class="wrap">
        <div class="an-grid" id="an-kpis"></div>
        <div class="an-charts" id="an-charts"></div>
      </div>
    </div>

    <!-- PROJ LOG -->
    <div class="page" id="page-proj">
      <div class="tl-wrap" id="proj-tl-wrap">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px" id="proj-header">
          <span style="font-size:18px;font-weight:600;color:var(--text1)" id="proj-title-bar">项目日志</span>
          <div style="display:flex;gap:8px">
            <button class="btn-add" style="background:rgba(88,86,214,.12);color:#5856d6;border:1px solid rgba(88,86,214,.25)" onclick="openThoughtModal()"><i class="ti ti-bulb" style="font-size:13px"></i>记录想法/Bug</button>
            <button class="btn-add" onclick="openProjLogModal()"><i class="ti ti-plus" style="font-size:14px"></i>版本记录</button>
          </div>
        </div>
        <div id="proj-tl-body"></div>
      </div>
    </div>

    <!-- SETTINGS -->
    <div class="page" id="page-settings">
      <div class="wrap">
        <div class="settings-wrap">
          <div class="settings-section">
            <div class="settings-section-head">
              <span class="settings-section-icon">☁️</span>
              <span class="settings-section-title">GitHub 云同步</span>
              <span class="settings-section-desc" id="sync-status-text">未配置</span>
            </div>
            <div class="settings-field">
              <div class="settings-label">GitHub 用户名</div>
              <input class="settings-input" id="cfg-owner" placeholder="your-username" oninput="cfgDirty()"/>
            </div>
            <div class="settings-field">
              <div class="settings-label">仓库名称</div>
              <input class="settings-input" id="cfg-repo" placeholder="workspace" oninput="cfgDirty()"/>
            </div>
            <div class="settings-field">
              <div class="settings-label">Personal Access Token <span class="settings-label-hint">— 仅存本地</span></div>
              <input class="settings-input" id="cfg-token" type="password" placeholder="ghp_xxxxxxxxxxxx" oninput="cfgDirty()"/>
            </div>
            <div class="settings-btn-row">
              <button class="settings-btn primary" onclick="saveConfig()">保存配置</button>
              <button class="settings-btn ghost" onclick="testSync()">测试连接</button>
              <button class="settings-btn ghost" onclick="forcePull()">从云端拉取</button>
            </div>
            <div class="sync-status-row">
              <div class="sync-dot" id="sync-dot"></div>
              <span id="sync-msg">尚未配置 GitHub 同步</span>
            </div>
            <div class="settings-info">前往 <a href="https://github.com/settings/tokens" target="_blank">github.com/settings/tokens</a> → Generate new token (classic) → 勾选 repo → 生成并复制。Token 仅保存在浏览器本地。</div>
          </div>
          <div class="settings-section">
            <div class="settings-section-head">
              <span class="settings-section-icon">🗄️</span>
              <span class="settings-section-title">本地数据</span>
            </div>
