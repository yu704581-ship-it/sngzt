var REVIEW_SYSTEM_PROMPT='你是一位结合《原则》《刻意练习》《思考快与慢》《穷查理宝典》四个框架的复盘教练。用户是企业培训师，同时负责团队AI系统搭建，处于快速探索期。\n\n分析时请做到：\n1. 找出今日复盘中的行为模式或重复问题\n2. 识别可能存在的认知盲点（尤其是过度乐观或确认偏误）\n3. 用逆向思维指出最大风险点\n4. 给出1-2条明天可执行的具体行动建议\n5. 语言简洁，不超过300字';
function buildUserMsg(parsed,mood){
  var q=function(i){return(parsed[i]||'').trim()||'（未填写）';};
  return'以下是我今天的复盘内容：\n\n① 表现对比（刻意练习）：'+q(0)+'\n② 错误日志（《原则》）：'+q(1)+'\n③ 认知偏差（《思考快与慢》）：'+q(2)+'\n④ 逆向避错（穷查理）：（未填写）\n⑤ 核心收获：（未填写）\n⑥ 明日聚焦：（未填写）\n今日状态：'+(mood||'（未填写）');
}
function doExportReviewWord(){
  if(!_exportSelectedIds.size){toast('请先勾选日期');return;}
  if(typeof docx==='undefined'){toast('docx.js 未加载，请检查网络连接');return;}
  var reviews=S.notes.filter(function(n){return n.cat==='review'&&_exportSelectedIds.has(n.id);})
    .sort(function(a,b){return a.created-b.created;});
  var D=docx;
  var children=[];
  reviews.forEach(function(note,idx){
    if(idx>0)children.push(new D.Paragraph({children:[new D.PageBreak()]}));
    // 标题
    children.push(new D.Paragraph({text:note.title||'复盘',heading:D.HeadingLevel.HEADING_1}));
    children.push(new D.Paragraph({children:[new D.TextRun({text:'日期：'+note.date+(note.duration?' · 复盘时长：'+fmtDuration(note.duration):'')+(note.mood?' · 心情：'+note.mood:''),color:'888888',size:20})]}));
    children.push(new D.Paragraph({text:''}));
    // 回答内容
    var parsed=parseReviewBody(note.body||'');
    var qlabels=['表现对比（刻意练习）','错误日志（《原则》）','认知偏差（《思考快与慢》）'];
    REVIEW_QS.forEach(function(q,i){
      children.push(new D.Paragraph({children:[new D.TextRun({text:q.icon+' '+q.label,bold:true,size:24})]}));
      var ans=(parsed[i]||'').trim();
      children.push(new D.Paragraph({children:[new D.TextRun({text:ans||'（未填写）',color:ans?'1c1c1e':'888888',size:22})],spacing:{after:160}}));
    });
    // 分隔
    children.push(new D.Paragraph({border:{bottom:{style:D.BorderStyle.SINGLE,size:6,color:'DDDDDD'}},text:''}));
    children.push(new D.Paragraph({text:''}));
    // 系统提示词
    children.push(new D.Paragraph({children:[new D.TextRun({text:'【发给 AI 的系统提示词（System Prompt）】',bold:true,color:'007aff',size:22})]}));
    REVIEW_SYSTEM_PROMPT.split('\n').forEach(function(line){
      children.push(new D.Paragraph({children:[new D.TextRun({text:line,size:20,color:'444444'})]}));
    });
    children.push(new D.Paragraph({text:''}));
    // 用户消息
    children.push(new D.Paragraph({children:[new D.TextRun({text:'【用户消息（直接粘贴给 AI）】',bold:true,color:'007aff',size:22})]}));
    buildUserMsg(parsed,note.mood).split('\n').forEach(function(line){
      children.push(new D.Paragraph({children:[new D.TextRun({text:line,size:22})]}));
    });
  });
  var doc=new D.Document({sections:[{properties:{},children:children}]});
  D.Packer.toBlob(doc).then(function(blob){
    var url=URL.createObjectURL(blob);
    var a=document.createElement('a');
    a.href=url;
    var dates=reviews.map(function(n){return n.date.replace(/\//g,'-');}).join('_');
    a.download='复盘_'+dates+'.docx';
    a.click();
    URL.revokeObjectURL(url);
    closeExportModal();
    toast('已导出 '+reviews.length+' 份复盘 ✓');
  }).catch(function(e){toast('导出失败：'+e.message);});
}
