function dayTaskDrop(e,targetId,targetColId){
  e.preventDefault();e.stopPropagation();
  document.querySelectorAll('.drop-above,.drop-below').forEach(function(x){x.classList.remove('drop-above','drop-below');});
  if(!_dayDragId||_dayDragId===targetId)return;
  var srcTask=S.tasks.find(function(t){return t.id===_dayDragId;});
  var tgtTask=S.tasks.find(function(t){return t.id===targetId;});
  if(!srcTask||!tgtTask)return;
  var newDate=colDateStr(targetColId);
  srcTask.date=newDate;
  // reorder: figure out insert position
  var colTasks=S.tasks.filter(function(t){return t.date===newDate&&!t.isTemplate;});
  colTasks=sortByOrder(colTasks);
  var tgtEl=eid('ti-'+targetId);
  var insertBefore=tgtEl&&tgtEl.classList.contains('drop-above');
  var tgtIdx=colTasks.findIndex(function(t){return t.id===targetId;});
  var prev=insertBefore?(tgtIdx>0?colTasks[tgtIdx-1]:null):colTasks[tgtIdx];
  var next=insertBefore?colTasks[tgtIdx]:(tgtIdx+1<colTasks.length?colTasks[tgtIdx+1]:null);
  if(prev&&prev.id===_dayDragId)prev=tgtIdx>1?colTasks[tgtIdx-2]:null;
  if(next&&next.id===_dayDragId)next=tgtIdx+2<colTasks.length?colTasks[tgtIdx+2]:null;
  var po=prev?(prev.sortOrder!=null?prev.sortOrder:prev.created):0;
  var no=next?(next.sortOrder!=null?next.sortOrder:next.created):Date.now()+200000;
  srcTask.sortOrder=Math.round((po+no)/2);
  save();renderDualDayView();updateSidebar();
}
