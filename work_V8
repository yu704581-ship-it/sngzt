/* ══════════════════════════════════
   CHAIN FUNCTIONS
══════════════════════════════════ */
function getChainRoot(id){
  var visited={};
  var cur=id;
  while(cur&&!visited[cur]){
    visited[cur]=true;
    var t=S.tasks.find(function(x){return x.id===cur;});
    if(!t||!t.prevId)return cur;
    cur=t.prevId;
  }
  return cur;
}
function buildChain(rootId){
  var chain=[];
  var visited={};
  var cur=rootId;
  while(cur&&!visited[cur]){
    visited[cur]=true;
    var t=S.tasks.find(function(x){return x.id===cur;});
    if(!t)break;
    chain.push(t);
    var next=S.tasks.find(function(x){return x.prevId===cur;});
    cur=next?next.id:null;
  }
  return chain;
}
function getChainPosition(id){
  var t=S.tasks.find(function(x){return x.id===id;});
  if(!t)return null;
  var hasPrev=!!(t.prevId&&S.tasks.find(function(x){return x.id===t.prevId;}));
  var hasNext=!!S.tasks.find(function(x){return x.prevId===id;});
  if(!hasPrev&&!hasNext)return null;
  var root=getChainRoot(id);
  var chain=buildChain(root);
  var idx=chain.findIndex(function(x){return x.id===id;});
  if(idx===-1)return null;
  return{n:idx+1,total:chain.length};
}
function renderChainView(){
  var el=eid('task-chain-view');if(!el)return;
  var tasks=S.tasks.filter(function(t){return !t.isTemplate;});
  // find all roots (tasks in a chain that have no prevId or prevId not found)
  var roots=tasks.filter(function(t){
    var hasNext=!!tasks.find(function(x){return x.prevId===t.id;});
    var hasPrev=!!(t.prevId&&tasks.find(function(x){return x.id===t.prevId;}));
    return !hasPrev&&hasNext;
  });
  if(!roots.length){
    el.innerHTML='<div class="chain-view-wrap"><div class="empty-state"><div class="empty-icon">⛓</div><p>还没有链路<br>完成任务后点击"接下一步"来创建链路</p></div></div>';
    return;
  }
  var html='<div class="chain-view-wrap">';
  roots.forEach(function(root){
    var chain=buildChain(root.id);
    var doneCount=chain.filter(function(t){return t.done;}).length;
    html+='<div class="chain-group">';
    html+='<div class="chain-group-label">⛓ 链路 · '+doneCount+'/'+chain.length+' 完成</div>';
    chain.forEach(function(t,i){
      var stepCls=t.done?'s-done':(t.status==='cancel'?'s-cancel':(t.status==='doing'?'s-doing':'s-todo'));
      html+='<div class="chain-task-row" onclick="openEditTask(\''+t.id+'\')">';
      html+='<div class="chain-step-col"><div class="chain-step-dot '+stepCls+'"></div>'+(i<chain.length-1?'<div class="chain-step-line"></div>':'')+'</div>';
      html+='<div class="chain-task-body"><div class="chain-task-title'+(t.done?' done':'')+'">'+esc(t.title)+'</div>';
      if(t.note)html+='<div style="font-size:11.5px;color:var(--text2);margin-top:2px;line-height:1.5">'+esc(t.note)+'</div>';
      var meta=[];
      if(t.date)meta.push(t.date);
      if(t.tag)meta.push(t.tag);
      if(meta.length)html+='<div class="chain-task-meta">'+meta.join(' · ')+'</div>';
      html+='</div>';
      html+='</div>';
    });
    // add next step button for the last task
    var last=chain[chain.length-1];
    if(last.done){
      html+='<div style="margin-top:8px;text-align:right"><button class="tl-act-btn" onclick="event.stopPropagation();openChainModal(\''+last.id+'\')">+ 接下一步</button></div>';
    }
    html+='</div>';
  });
  html+='</div>';
  el.innerHTML=html;
}
function openChainModal(id){
  _chainForId=id;
  var t=S.tasks.find(function(x){return x.id===id;});
  eid('chain-from-lbl').textContent='上一步：'+(t?t.title:'');
  eid('chain-title-inp').value='';
  eid('chain-remark-inp').value='';
  var ov=eid('chain-modal-overlay');
  ov.classList.add('open');
  setTimeout(function(){eid('chain-title-inp').focus();},80);
}
function closeChainModal(){
  eid('chain-modal-overlay').classList.remove('open');
  _chainForId=null;
}
function handleChainKey(e){
  if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();confirmChainModal();}
  if(e.key==='Escape')closeChainModal();
}
function handleChainRemarkKey(e){
  if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();confirmChainModal();}
  if(e.key==='Escape')closeChainModal();
}
function confirmChainModal(){
  var title=eid('chain-title-inp').value.trim();
  if(!title)return;
  var prev=_chainForId?S.tasks.find(function(x){return x.id===_chainForId;}):null;
  var newTask={
    id:'t'+Date.now(),title:title,
    note:eid('chain-remark-inp').value.trim()||'',
    tag:prev?prev.tag:'',
    date:prev?prev.date:todayStr(),
    done:false,status:'todo',priority:'normal',
    created:Date.now(),
    prevId:_chainForId||null
  };
  S.tasks.push(newTask);
  save();
  renderAllTasks();renderTodayTasks();renderGreeting();updateSidebar();
  closeChainModal();
}
function openChainDetail(id,event){
  if(event)event.stopPropagation();
  var root=getChainRoot(id);
  var chain=buildChain(root);
  var box=eid('chain-detail-box');
  var doneCount=chain.filter(function(t){return t.done;}).length;
  var html='<div class="chain-detail-hd"><span>⛓ 链路 '+doneCount+'/'+chain.length+'</span><button class="modal-close" onclick="closeChainDetail()" style="font-size:18px;border:none;background:none;cursor:pointer;color:var(--text3)">×</button></div>';
  chain.forEach(function(t,i){
    var dotCls=t.done?'done':(t.status==='cancel'?'cancel':(t.status==='doing'?'doing':'todo'));
    var dotInner=t.done?'✓':'';
    html+='<div class="chain-detail-item"><div class="chain-detail-dot '+dotCls+'">'+dotInner+'</div>';
    html+='<div class="chain-detail-body" onclick="closeChainDetail();setTimeout(function(){openEditTask(\''+t.id+'\')},80)">';
    html+='<div class="chain-detail-ttl'+(t.done?' done':'')+'">'+esc(t.title)+'</div>';
    if(t.note)html+='<div style="font-size:12px;color:var(--text2);margin-top:3px;line-height:1.5;white-space:pre-wrap">'+esc(t.note)+'</div>';
    var sub=[];if(t.date)sub.push(t.date);if(t.tag)sub.push(t.tag);
    if(sub.length)html+='<div class="chain-detail-sub">'+sub.join(' · ')+'</div>';
    html+='</div></div>';
    if(i<chain.length-1)html+='<div class="chain-detail-line"></div>';
  });
  var last=chain[chain.length-1];
  if(last.done){
    html+='<div style="margin-top:14px"><button class="chain-confirm" style="width:100%" onclick="closeChainDetail();openChainModal(\''+last.id+'\')">+ 接下一步</button></div>';
  }
  box.innerHTML=html;
  eid('chain-detail-overlay').classList.add('open');
}
function closeChainDetail(){
  eid('chain-detail-overlay').classList.remove('open');
}

/* ══════════════════════════════════
   PROJECT LOG FUNCTIONS
══════════════════════════════════ */
function selectProject(id){
  _activeProject=id;
  renderProjSidebar();
  renderProj();
}
function renderProjSidebar(){
  var el=eid('sb-proj-list');if(!el)return;
  var html='<div class="proj-sb-section"><div class="proj-sb-label">项目</div>';
  S.projects.forEach(function(p){
    html+='<div class="proj-item'+(_activeProject===p.id?' active':'')+'" onclick="selectProject(\''+p.id+'\')">';
    html+='<div class="proj-dot-sm" style="background:'+p.color+'"></div>';
    html+='<span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(p.name)+'</span>';
    html+='<button class="proj-del-btn" onclick="event.stopPropagation();deleteProject(\''+p.id+'\')" title="删除项目">×</button>';
    html+='</div>';
  });
  if(S.projects.length<5){
    html+='<button class="proj-add-btn" onclick="openNewProjModal()"><i class="ti ti-plus" style="font-size:12px"></i>新建项目</button>';
  }
  html+='</div>';
  el.innerHTML=html;
}
function renderProj(){
  var titleBar=eid('proj-title-bar');
  var body=eid('proj-tl-body');
  var hdr=eid('proj-header');
  if(!body)return;
  if(!_activeProject||!S.projects.find(function(p){return p.id===_activeProject;})){
    if(S.projects.length){
      _activeProject=S.projects[0].id;
    } else {
      if(titleBar)titleBar.textContent='项目日志';
      if(hdr){
        var addbtn=hdr.querySelector('.btn-add');
        if(addbtn)addbtn.style.display='none';
      }
      body.innerHTML='<div class="empty-state"><div class="empty-icon">📋</div><p>还没有项目<br>点击左侧"新建项目"开始</p></div>';
      return;
    }
  }
  var proj=S.projects.find(function(p){return p.id===_activeProject;});
  if(!proj)return;
  if(titleBar)titleBar.innerHTML='<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:'+proj.color+';margin-right:7px;vertical-align:middle"></span>'+esc(proj.name);
  if(hdr){document.querySelectorAll('#proj-header .btn-add').forEach(function(b){b.style.display='';});}
  if(!proj.logs||!proj.logs.length){
    body.innerHTML='<div class="empty-state"><div class="empty-icon">📝</div><p>还没有记录<br>点击右上角按钮添加</p></div>';
    return;
  }
  // group by month
  var byMonth={};
  proj.logs.forEach(function(lg){
    var month=lg.isoDate?lg.isoDate.slice(0,7):'未知';
    if(!byMonth[month])byMonth[month]=[];
    byMonth[month].push(lg);
  });
  var months=Object.keys(byMonth).sort().reverse();
  var html='';
  months.forEach(function(m){
    html+='<div class="tl-year-sep">'+m+'</div>';
    var entries=byMonth[m].slice().sort(function(a,b){return b.isoDate>a.isoDate?1:-1;});
    entries.forEach(function(lg,i){
      var isLast=i===entries.length-1;
      html+='<div class="tl-entry">';
      if(lg.kind==='thought'){
        var dotCls=lg.status==='solved'?'thought-solved':(lg.status==='doing'?'thought-doing':'thought-dot');
        html+='<div class="tl-spine"><div class="tl-dot '+dotCls+'"></div>'+(isLast?'':'<div class="tl-spine-line"></div>')+'</div>';
        html+='<div class="tl-card is-thought st-'+lg.status+'">';
        html+='<div class="th-type-badge">'+(lg.type==='bug'?'🐛 Bug':'💡 想法')+'</div>';
        html+='<div class="tl-card-head"><span class="tl-note-title">'+esc(lg.title)+'</span><span class="tl-time">'+lg.time+'</span></div>';
        if(lg.body)html+='<div class="tl-note-body">'+esc(lg.body)+'</div>';
        html+='<div class="st-row"><span class="st-lbl">状态：</span>';
        ['pending','doing','solved'].forEach(function(s){
          var lbl=s==='pending'?'待处理':s==='doing'?'处理中':'已解决';
          html+='<button class="st-btn'+(lg.status===s?' active-'+s:'')+'" onclick="setThoughtStatus(\''+proj.id+'\',\''+lg.id+'\',\''+s+'\')">'+lbl+'</button>';
        });
        if(lg.status==='solved'&&lg.solvedAt)html+='<span class="solved-ts">解决于 '+lg.solvedAt+'</span>';
        html+='</div>';
        html+='<div class="tl-card-actions"><button class="tl-act-btn" onclick="openThoughtModal(\''+proj.id+'\',\''+lg.id+'\')">编辑</button><button class="tl-act-btn del" onclick="deleteProjLog(\''+proj.id+'\',\''+lg.id+'\')">删除</button></div>';
        html+='</div></div>';
      } else {
        var mainTag=lg.tags&&lg.tags.length?lg.tags[0]:'mix';
        var dotCls=mainTag==='feat'?'feat':mainTag==='fix'?'fix':mainTag==='opt'?'opt':'mix';
        html+='<div class="tl-spine"><div class="tl-dot '+dotCls+'"></div>'+(isLast?'':'<div class="tl-spine-line"></div>')+'</div>';
        html+='<div class="tl-card">';
        html+='<div class="tl-card-head"><span class="tl-ver">'+esc(lg.ver||'')+'</span><span class="tl-time">'+lg.time+'</span></div>';
        if(lg.tags&&lg.tags.length){
          html+='<div class="tl-badges">';
          lg.tags.forEach(function(tg){
            var lbl=tg==='feat'?'新增':tg==='fix'?'修复':tg==='opt'?'优化':tg;
            var cls=tg==='feat'||tg==='fix'||tg==='opt'?tg:'custom';
            html+='<span class="tl-badge '+cls+'">'+lbl+'</span>';
          });
          html+='</div>';
        }
        if(lg.points&&lg.points.length){
          html+='<div class="tl-points">';
          lg.points.forEach(function(pt){html+='<div class="tl-point-row"><span class="tl-bullet">·</span><span>'+esc(pt)+'</span></div>';});
          html+='</div>';
        }
        if(lg.detail)html+='<div class="tl-note-body" style="margin-top:5px">'+esc(lg.detail)+'</div>';
        html+='<div class="tl-card-actions"><button class="tl-act-btn" onclick="openProjLogModal(\''+proj.id+'\',\''+lg.id+'\')">编辑</button><button class="tl-act-btn del" onclick="deleteProjLog(\''+proj.id+'\',\''+lg.id+'\')">删除</button></div>';
        html+='</div></div>';
      }
    });
  });
  body.innerHTML=html;
}
function openNewProjModal(){
  _npColor=PROJ_COLORS[0];
  eid('np-name-inp').value='';
  renderNpColorRow();
  eid('new-proj-overlay').style.display='flex';
  setTimeout(function(){eid('np-name-inp').focus();},80);
}
function closeNewProjModal(){eid('new-proj-overlay').style.display='none';}
function renderNpColorDot(){}
function renderNpColorRow(){
  var row=eid('np-color-row');if(!row)return;
  row.innerHTML=PROJ_COLORS.map(function(c){
    return'<div onclick="selectNpColor(\''+c+'\')" style="width:20px;height:20px;border-radius:50%;background:'+c+';cursor:pointer;border:2px solid '+(c===_npColor?'var(--text1)':'transparent')+';box-sizing:border-box"></div>';
  }).join('');
}
function selectNpColor(c){_npColor=c;renderNpColorRow();}
function confirmNewProject(){
  var name=eid('np-name-inp').value.trim();
  if(!name)return;
  if(S.projects.length>=5){alert('最多创建 5 个项目');return;}
  var p={id:'p'+Date.now(),name:name,color:_npColor,logs:[]};
  S.projects.push(p);
  _activeProject=p.id;
  saveProjects();
  closeNewProjModal();
  renderProjSidebar();
  renderProj();
}
function deleteProject(id){
  if(!confirm('确定删除这个项目及其所有日志？'))return;
  S.projects=S.projects.filter(function(p){return p.id!==id;});
  if(_activeProject===id)_activeProject=S.projects.length?S.projects[0].id:null;
  saveProjects();
  renderProjSidebar();
  renderProj();
}
var _plBuiltInTags=['feat','fix','opt'];
function openProjLogModal(projId,logId){
  var pid=projId||_activeProject;
  if(!pid){alert('请先选择或创建一个项目');return;}
  _editLogId=logId||null;
  _plSelectedTags=[];
  var lg=null;
  if(logId){
    var proj=S.projects.find(function(p){return p.id===pid;});
    if(proj)lg=(proj.logs||[]).find(function(l){return l.id===logId;});
  }
  eid('proj-log-modal-title').textContent=logId?'编辑版本记录':'版本记录';
  eid('pl-ver-inp').value=lg?lg.ver||'':'';
  eid('pl-points-inp').value=lg&&lg.points?lg.points.join('\n'):'';
  eid('pl-detail-inp').value=lg?lg.detail||'':'';
  _plSelectedTags=lg&&lg.tags?lg.tags.slice():[];
  renderPlTags();
  eid('proj-log-overlay').style.display='flex';
  setTimeout(function(){eid('pl-ver-inp').focus();},80);
}
function closeProjLogModal(){eid('proj-log-overlay').style.display='none';_editLogId=null;}
function renderPlTags(){
  var row=eid('pl-tag-row');if(!row)return;
  var builtIn=[{k:'feat',l:'新增'},{k:'fix',l:'修复'},{k:'opt',l:'优化'}];
  var html=builtIn.map(function(b){
    var sel=_plSelectedTags.indexOf(b.k)!==-1;
    return'<div class="pl-tag'+(sel?' selected '+b.k:'')+'" onclick="togglePlTag(\''+b.k+'\')">'+b.l+'</div>';
  }).join('');
  // custom tags
  _plSelectedTags.filter(function(t){return _plBuiltInTags.indexOf(t)===-1;}).forEach(function(t){
    html+='<div class="pl-tag selected custom" onclick="togglePlTag(\''+t+'\')">'+esc(t)+' ×</div>';
  });
  html+='<button class="pl-tag-add" onclick="addCustomPlTag()">+ 自定义</button>';
  row.innerHTML=html;
}
function togglePlTag(k){
  var idx=_plSelectedTags.indexOf(k);
  if(idx===-1)_plSelectedTags.push(k); else _plSelectedTags.splice(idx,1);
  renderPlTags();
}
function addCustomPlTag(){
  var v=prompt('自定义标签名：');
  if(v&&v.trim()&&_plSelectedTags.indexOf(v.trim())===-1)_plSelectedTags.push(v.trim());
  renderPlTags();
}
function confirmProjLog(){
  var pid=_activeProject;
  if(!pid)return;
  var proj=S.projects.find(function(p){return p.id===pid;});
  if(!proj)return;
  var ver=eid('pl-ver-inp').value.trim();
  var raw=eid('pl-points-inp').value;
  var points=raw.split('\n').map(function(l){return l.trim().replace(/^[·•\-\*]\s*/,'');}).filter(Boolean);
  var detail=eid('pl-detail-inp').value.trim();
  var now=new Date();
  var isoDate=now.toISOString().slice(0,10);
  var time=now.toLocaleTimeString('zh-CN',{hour:'2-digit',minute:'2-digit'});
  if(!proj.logs)proj.logs=[];
  if(_editLogId){
    var lg=proj.logs.find(function(l){return l.id===_editLogId;});
    if(lg){lg.ver=ver;lg.tags=_plSelectedTags.slice();lg.points=points;lg.detail=detail;}
  } else {
    proj.logs.unshift({id:'lg'+Date.now(),ver:ver,tags:_plSelectedTags.slice(),points:points,detail:detail,isoDate:isoDate,time:time});
  }
  saveProjects();
  closeProjLogModal();
  renderProj();
}
function deleteProjLog(projId,logId){
  if(!confirm('确定删除这条记录？'))return;
  var proj=S.projects.find(function(p){return p.id===projId;});
  if(!proj)return;
  proj.logs=proj.logs.filter(function(l){return l.id!==logId;});
  saveProjects();
  renderProj();
}
function openThoughtModal(projId,logId){
  var pid=projId||_activeProject;
  if(!pid){alert('请先选择或创建一个项目');return;}
  _editThoughtId=logId||null;
  _thoughtType='idea';
  var lg=null;
  if(logId){
    var proj=S.projects.find(function(p){return p.id===pid;});
    if(proj)lg=(proj.logs||[]).find(function(l){return l.id===logId;});
    if(lg)_thoughtType=lg.type||'idea';
  }
  setThoughtTypeUI(_thoughtType);
  eid('th-title-inp').value=lg?lg.title||'':'';
  eid('th-body-inp').value=lg?lg.body||'':'';
  eid('thought-modal-title').textContent=logId?'编辑记录':'记录想法 / Bug';
  eid('thought-overlay').style.display='flex';
  setTimeout(function(){eid('th-title-inp').focus();},80);
}
function closeThoughtModal(){eid('thought-overlay').style.display='none';_editThoughtId=null;}
function setThoughtType(t){_thoughtType=t;setThoughtTypeUI(t);}
function setThoughtTypeUI(t){
  var idea=eid('tt-idea'),bug=eid('tt-bug');
  if(idea){idea.className='pl-tag'+(t==='idea'?' selected custom':'');}
  if(bug){bug.className='pl-tag'+(t==='bug'?' selected fix':'');}
}
function confirmThought(){
  var pid=_activeProject;if(!pid)return;
  var proj=S.projects.find(function(p){return p.id===pid;});if(!proj)return;
  var title=eid('th-title-inp').value.trim();
  var body=eid('th-body-inp').value.trim();
  if(!title)return;
  var now=new Date();
  var isoDate=now.toISOString().slice(0,10);
  var time=now.toLocaleTimeString('zh-CN',{hour:'2-digit',minute:'2-digit'});
  if(!proj.logs)proj.logs=[];
  if(_editThoughtId){
    var lg=proj.logs.find(function(l){return l.id===_editThoughtId;});
    if(lg){lg.type=_thoughtType;lg.title=title;lg.body=body;}
  } else {
    proj.logs.unshift({id:'th'+Date.now(),kind:'thought',type:_thoughtType,title:title,body:body,status:'pending',isoDate:isoDate,time:time});
  }
  saveProjects();
  closeThoughtModal();
  renderProj();
}
function setThoughtStatus(projId,logId,status){
  var proj=S.projects.find(function(p){return p.id===projId;});if(!proj)return;
  var lg=(proj.logs||[]).find(function(l){return l.id===logId;});if(!lg)return;
  lg.status=status;
  if(status==='solved'&&!lg.solvedAt)lg.solvedAt=new Date().toISOString().slice(0,10);
  saveProjects();
  renderProj();
}
</script>
