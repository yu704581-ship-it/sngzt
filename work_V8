  document.querySelectorAll('.drop-above,.drop-below').forEach(function(x){x.classList.remove('drop-above','drop-below');});
  var el=eid('ti-'+targetId);if(!el||targetId===_dayDragId)return;
  var mid=el.getBoundingClientRect().top+el.getBoundingClientRect().height/2;
  el.classList.add(e.clientY<mid?'drop-above':'drop-below');
