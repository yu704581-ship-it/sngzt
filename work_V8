      ta.focus();
      var html=convert?renderMarkdown(_mdPasteText):_mdPasteText.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>');
      document.execCommand('insertHTML',false,html);
      debounceCeSave(noteId);
    } else {
      var s=ta.selectionStart,e=ta.selectionEnd,v=ta.value;
      ta.value=v.slice(0,s)+_mdPasteText+v.slice(e);
