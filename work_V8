.review-week-day.today .review-day-num{background:var(--accent);color:#fff;border-radius:50%}
.review-week-day.has-review .review-day-dot{background:var(--accent)}
.review-week-day.active{background:var(--accent-light)}
.review-day-name{font-size:10px;color:var(--text3);font-weight:500}
.review-day-num{font-size:13px;font-weight:600;color:var(--text1);width:26px;height:26px;display:flex;align-items:center;justify-content:center}
.review-day-dot{width:4px;height:4px;border-radius:50%;background:transparent;transition:background .15s}
.review-card{background:rgba(255,255,255,.76);backdrop-filter:blur(14px) saturate(160%);-webkit-backdrop-filter:blur(14px) saturate(160%);border-radius:var(--r);padding:14px 16px;cursor:pointer;border:0.5px solid rgba(255,255,255,.9);box-shadow:var(--shadow-card);margin-bottom:8px;animation:cardIn .2s var(--spring) both;transition:box-shadow .2s,transform .18s var(--ease)}
.review-card:hover{transform:translateY(-1px);box-shadow:0 6px 20px rgba(0,0,0,.09)}
.review-card-title{font-size:14px;font-weight:500;color:var(--text1);margin-bottom:4px}
.review-card-preview{font-size:12.5px;color:var(--text2);line-height:1.6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.review-card-foot{display:flex;align-items:center;justify-content:space-between;margin-top:8px}
.review-q-block{margin-bottom:20px;background:rgba(255,255,255,.6);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-radius:var(--rs);padding:14px 16px;border:0.5px solid rgba(255,255,255,.8)}
.review-q-label-row{display:flex;align-items:center;gap:7px;margin-bottom:6px}
