function renderTodayTasks(){renderDualDayView();}

function sortByOrder(tasks){
  return tasks.slice().sort(function(a,b){
    var aDone=!!(a.done||a.status==='done'||a.status==='cancel');
    var bDone=!!(b.done||b.status==='done'||b.status==='cancel');
    if(aDone!==bDone)return aDone?1:-1;
    var ao=a.sortOrder!=null?a.sortOrder:a.created;
    var bo=b.sortOrder!=null?b.sortOrder:b.created;
    return ao-bo;
  });
}

