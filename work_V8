function stopReviewTimer(){
  if(!_reviewTimer.running)return;
  clearInterval(_reviewTimer.interval);
  _reviewTimer.elapsed+=Date.now()-_reviewTimer.start;
  _reviewTimer.running=false;
  var id=_reviewTimer.noteId;
  var note=S.notes.find(function(n){return n.id===id;});
  if(note){note.duration=_reviewTimer.elapsed;save();}
  var btn=eid('rv-timer-btn-'+id);if(btn){btn.textContent='▶ 开始';btn.classList.remove('running');}
  updateReviewTimerUI(id);
}
function updateReviewTimerUI(noteId){
  var el=eid('rv-timer-'+noteId);if(!el)return;
  var elapsed=_reviewTimer.elapsed+(_reviewTimer.running?(Date.now()-_reviewTimer.start):0);
  el.textContent=fmtDuration(elapsed)||'0秒';
