.review-q-hints{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}
.review-q-hint{font-size:11.5px;color:var(--text3);background:var(--surface3);border-radius:20px;padding:2px 9px;cursor:pointer;transition:background .12s,color .12s}
.review-q-hint:hover{background:var(--accent-light);color:var(--accent)}
.review-q-input{width:100%;border:none;outline:none;background:rgba(118,118,128,.06);border-radius:var(--rxs);font-family:inherit;font-size:14px;color:var(--text1);padding:10px 12px;resize:none;line-height:1.65;min-height:72px;transition:background .15s,box-shadow .15s}
.review-q-input:focus{background:rgba(255,255,255,.9);box-shadow:0 0 0 2px var(--accent-border)}
.review-mood-block{margin-bottom:20px;background:rgba(255,255,255,.6);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-radius:var(--rs);padding:14px 16px;border:0.5px solid rgba(255,255,255,.8)}
.review-mood-title{font-size:13px;font-weight:600;color:var(--text1);margin-bottom:10px}
.review-mood-tags{display:flex;flex-wrap:wrap;gap:8px}
.review-mood-tag{padding:6px 14px;border-radius:20px;border:1px solid var(--border2);background:var(--surface3);font-size:13px;cursor:pointer;transition:all .15s;user-select:none}
