══════════════════════════════════ */
function toggleTask(id){
  var t=S.tasks.find(function(x){return x.id===id;});if(!t)return;
  t.done=!t.done;
  if(t.done)t.status='done';
  else t.status='todo';
  save();
  renderTodayTasks();renderAllTasks();updateSidebar();
  if(t.done)setTimeout(function(){
    if(S.currentTab==='today')showInlineNextStep(id);
    else showNextStepToast(id);
  },150);
}

function deleteTask(id,e){
  if(e)e.stopPropagation();
  S.tasks=S.tasks.filter(function(t){return t.id!==id;});
