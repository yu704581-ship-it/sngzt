.review-timer-wrap{display:flex;align-items:center;gap:8px;margin-left:auto}
.review-timer-display{font-size:13px;font-weight:600;color:var(--text2);letter-spacing:.04em;min-width:44px;text-align:right}
.review-timer-btn{padding:4px 12px;border-radius:var(--rxs);border:1px solid var(--border2);background:var(--surface2);color:var(--text2);font-size:12px;cursor:pointer;font-family:inherit;transition:all .15s}
