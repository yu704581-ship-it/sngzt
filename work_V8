var REVIEW_SEP='\n\n---REVIEW_SEP---\n\n';
function parseReviewBody(body){
  if(!body)return['','',''];
  if(body.indexOf('---REVIEW_SEP---')!==-1){var parts=body.split(REVIEW_SEP);while(parts.length<3)parts.push('');return parts.slice(0,3);}
  return[body,'',''];
}
