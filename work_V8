/* ══════════════════════════════════
   MIGRATE FROM SS工作台 (wb_v22)
══════════════════════════════════ */
function migrateFromWbV22(){
  try{
    var raw=localStorage.getItem('wb_v22');
    if(!raw||localStorage.getItem('ws_migrated_wb22'))return;
    var d=JSON.parse(raw);
    // 日期格式转换: "2026-06-06" → "06/06"
    function cvDate(iso){
      if(!iso)return todayStr();
      var p=iso.split('-');if(p.length<3)return todayStr();
      return p[1]+'/'+p[2];
    }
    // 迁移 tags (note_tags + todo_tags 合并去重)
    var allTags=[].concat(d.note_tags||[],d.todo_tags||[],d.tags||[]);
    var seenTags={};
    allTags.forEach(function(t){
      if(t&&t.id&&!seenTags[t.id]){
        seenTags[t.id]=true;
        if(!TAGS.find(function(x){return x.id===t.id;})){TAGS.push({id:t.id,label:t.label||t.id});}
      }
    });
    saveTags();
    // 迁移 todos → tasks
    var importedTasks=0;
    (d.todos||[]).forEach(function(t){
      if(S.tasks.find(function(x){return String(x.id)===String(t.id);}))return;
      S.tasks.push({
        id:String(t.id),
        title:t.text||'',
        tag:(t.tags&&t.tags[0])||(t.tags&&t.tags[0]&&t.tags[0].id)||'',
        date:cvDate(t.isoDate),
        done:!!t.done,
        status:t.status||'todo',
        priority:t.priority||'normal',
        note:'',
        images:t.images||[],
        created:t.created||Date.now()
      });
      importedTasks++;
    });
    // 迁移 notes → notes (plain text as body)
    var importedNotes=0;
    (d.notes||[]).forEach(function(n){
      if(S.notes.find(function(x){return String(x.id)===String(n.id);}))return;
      var firstTag=n.tags&&n.tags[0];
      var catId=firstTag?(typeof firstTag==='string'?firstTag:firstTag.id):'experience';
      S.notes.push({
        id:String(n.id),
        title:'',
        body:n.text||'',
        cat:catId,
        date:cvDate(n.isoDate),
        created:n.created||Date.now(),
        images:n.images||[]
      });
      importedNotes++;
    });
    // 迁移 experiences → notes (cat='experience')
    (d.experiences||[]).forEach(function(e){
      if(S.notes.find(function(x){return String(x.id)===String(e.id);}))return;
      S.notes.push({
        id:String(e.id),
        title:e.title||'',
        body:e.body||'',
        cat:'experience',
        date:cvDate(e.isoDate),
        created:e.created||Date.now(),
        images:[]
      });
      importedNotes++;
    });
    // 迁移 inbox
    (d.inbox||[]).forEach(function(item){
      if(!S.inbox.find(function(x){return String(x.id)===String(item.id);})){S.inbox.push(item);}
    });
    save();
    localStorage.setItem('ws_migrated_wb22','1');
    toast('已从旧版工作台导入 '+importedTasks+' 个任务、'+importedNotes+' 条笔记 ✓');
  }catch(e){console.warn('迁移失败',e);}
}
function checkMigration(){
  if(!localStorage.getItem('wb_v22')||localStorage.getItem('ws_migrated_wb22'))return;
  // 用提示框让用户确认
  var div=document.createElement('div');
  div.style.cssText='position:fixed;bottom:80px;left:50%;transform:translateX(-50%);background:rgba(255,255,255,.96);backdrop-filter:blur(20px);border-radius:12px;padding:16px 20px;box-shadow:0 8px 32px rgba(0,0,0,.18);z-index:9999;display:flex;align-items:center;gap:12px;border:0.5px solid rgba(60,60,67,.12);max-width:420px;width:90vw';
