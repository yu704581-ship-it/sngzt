/* ── MARKDOWN RENDERER ── */
function renderMarkdown(src){
  if(!src)return'';
  var lines=src.split('\n'),html='',inCode=false,codeLines=[],inList=false,listType='';
  function closeList(){if(inList){html+='</'+listType+'>';inList=false;listType='';}}
  function inline(t){
    return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
      .replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>')
      .replace(/\*(.+?)\*/g,'<em>$1</em>')
      .replace(/==(.+?)==/g,'<mark>$1</mark>')
      .replace(/`([^`]+)`/g,'<code>$1</code>')
      .replace(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g,'<a href="$2" target="_blank" rel="noopener">$1</a>');
  }
  lines.forEach(function(line){
    if(/^```/.test(line)){
      if(inCode){html+='<pre><code>'+codeLines.join('\n').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')+'</code></pre>';codeLines=[];inCode=false;}
      else{closeList();inCode=true;}return;
    }
    if(inCode){codeLines.push(line);return;}
    var hm=line.match(/^(#{1,3}) (.+)/);
    if(hm){closeList();html+='<h'+hm[1].length+'>'+inline(hm[2])+'</h'+hm[1].length+'>';return;}
    if(/^---+$/.test(line.trim())){closeList();html+='<hr>';return;}
    var bq=line.match(/^> (.+)/);
    if(bq){closeList();html+='<blockquote>'+inline(bq[1])+'</blockquote>';return;}
    var ul=line.match(/^[-*] (.+)/);
    if(ul){
      if(!inList||listType!=='ul'){closeList();html+='<ul>';inList=true;listType='ul';}
      html+='<li>'+inline(ul[1])+'</li>';return;
    }
    var ol=line.match(/^\d+\. (.+)/);
    if(ol){
      if(!inList||listType!=='ol'){closeList();html+='<ol>';inList=true;listType='ol';}
      html+='<li>'+inline(ol[1])+'</li>';return;
    }
    closeList();
    if(!line.trim()){html+='<p style="margin:4px 0"></p>';return;}
    html+='<p>'+inline(line)+'</p>';
  });
  closeList();return html;
}
/* ── MARKDOWN TOOLBAR ── */
function mdFmt(noteId,cmd){
  var ta=eid('nd-body-'+noteId);if(!ta)return;
  var s=ta.selectionStart,e=ta.selectionEnd,v=ta.value,sel=v.slice(s,e);
  var wrap=function(pre,suf){var r=(sel||'文字');ta.value=v.slice(0,s)+pre+r+suf+v.slice(e);ta.selectionStart=s+pre.length;ta.selectionEnd=s+pre.length+r.length;ta.focus();updateNoteField(noteId,'body',ta.value);};
  var prefix=function(p){
    var ls=v.lastIndexOf('\n',s-1)+1,line=v.slice(ls,s+(e-s));
    ta.value=v.slice(0,ls)+p+v.slice(ls);ta.selectionStart=ta.selectionEnd=ls+p.length+(s-ls);ta.focus();updateNoteField(noteId,'body',ta.value);
  };
  if(cmd==='h1')prefix('# ');
  else if(cmd==='h2')prefix('## ');
  else if(cmd==='h3')prefix('### ');
  else if(cmd==='bold')wrap('**','**');
  else if(cmd==='italic')wrap('*','*');
  else if(cmd==='highlight')wrap('==','==');
  else if(cmd==='code')wrap('`','`');
  else if(cmd==='link'){var url=prompt('链接地址');if(!url)return;ta.value=v.slice(0,s)+'['+(sel||'链接文字')+']('+url+')'+v.slice(e);updateNoteField(noteId,'body',ta.value);}
  else if(cmd==='ul')prefix('- ');
  else if(cmd==='ol')prefix('1. ');
  else if(cmd==='hr'){var ins='\n---\n';ta.value=v.slice(0,s)+ins+v.slice(e);ta.selectionStart=ta.selectionEnd=s+ins.length;updateNoteField(noteId,'body',ta.value);}
  // 工具栏操作后始终显示预览，不暴露原始符号
  var pv2=eid('nd-preview-'+noteId);
